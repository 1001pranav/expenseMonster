{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "production" }
    },
    "preview-nosms": {
      "extends": "preview",
      "env": { "APP_VARIANT": "production", "SMS": "off" }
    },
    "play": {
      "android": { "buildType": "app-bundle" },
      "env": { "APP_VARIANT": "production", "STORE": "play" }
    }
  }
}
