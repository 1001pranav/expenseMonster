# Copy to .env.local (git-ignored) for local builds. For GitHub Actions, add each key as a variable
# in the DEV environment, or paste these lines into an APP_ENV secret there. No quotes needed.
#
# Supabase dashboard → Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_…) or legacy "anon public" key.
# NEVER the secret / service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
